# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# Alpaca PAPER trading keys: app.alpaca.markets -> switch to Paper -> API Keys.
# This project only ever talks to the paper environment.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# "iex" works on Alpaca's free plan.
ALPACA_DATA_FEED=iex

# Strategy: ma_crossover | trend | momentum (see README)
STRATEGY=ma_crossover
FAST_WINDOW=20
SLOW_WINDOW=50
TREND_WINDOW=200
MOMENTUM_LOOKBACK=252
MOMENTUM_TOP=3
# Invest less when the picks' last N trading days were more volatile than their last year
# (0 = off; 21 passed the backtests: smaller worst drops at about the same return)
MOMENTUM_VOL_SCALE=0

# Crash mode: switch to a backup while the market is crash-like (see README)
CRASH_SWITCH=false
CRASH_INDEX=QQQ
CRASH_DRAWDOWN=10
CRASH_WINDOW=200
# closes in a row the crash rule must hold before switching either way (1 = switch at once;
# above 1 the check also uses finished daily closes only, not the live price)
CRASH_CONFIRM_DAYS=1
# defensive = best of CRASH_ASSETS over 3 months; cash = hold cash
CRASH_MODE=defensive
CRASH_ASSETS=BIL,IEF,TLT,GLD

# What to trade: tickers and/or @presets from trader_core/universes.py
# (@etf4, @sectors, @assets, @mega2020, @tech2020), e.g. SYMBOLS=@sectors or SYMBOLS=@etf4,NVDA
SYMBOLS=SPY,QQQ,GLD,TLT
INITIAL_CAPITAL=100000
# Yearly interest on uninvested cash in backtests, in percent (e.g. 3)
CASH_RATE=0

# Backtest price source: alpaca | yfinance | synthetic (fake prices, no key needed)
DATA_PROVIDER=alpaca

# Buy fractional shares where Alpaca allows it, so every slot is fully invested
FRACTIONAL_SHARES=true

# "close" = decide from completed daily closes; "intraday" = include the live price right now
# (the backtester simulates both)
SIGNAL_MODE=close
# true = decide and record, but never send orders
DRY_RUN=false

# --- Safeguards (see README "Safety"). Percents are of the whole account. ---
# Kill switch: true = record balances but place no orders
TRADING_HALTED=false
# No single buy bigger than this, and no buy leaving one symbol above that
MAX_ORDER_PCT=25
MAX_POSITION_PCT=30
# Cancel the whole run if it plans more orders than this
MAX_ORDERS_PER_RUN=20
# Skip a symbol this run if its live price is this far from its last close, or its data is this old
MAX_PRICE_MOVE_PCT=40
MAX_DATA_AGE_DAYS=5
# Circuit breaker: halt (until `python -m live_trader --resume`) after this loss in a day / from the peak
DAILY_LOSS_HALT_PCT=15
DRAWDOWN_HALT_PCT=60
# Optional: AWS SNS topic that emails you alerts (set up on AWS; without it alerts only go to the log)
# ALERT_TOPIC_ARN=

# Used when you run the Python code directly (docker compose points at its own Postgres)
DATABASE_URL=sqlite:///trading.db

# Optional: password prompt in front of the dashboard
# DASHBOARD_PASSWORD=
